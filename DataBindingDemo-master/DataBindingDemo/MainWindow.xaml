<Window x:Class="DataBindingDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DataBindingDemo.Views"
        Title="ЛР2 — Привязка данных и триггеры" 
        Height="650" Width="950"
        Background="White">

    <TabControl Margin="10" FontSize="14">
        <TabItem Header="Привязка по умолчанию">
            <views:DefaultBindingView/>
        </TabItem>
        <TabItem Header="Двухсторонняя привязка">
            <views:TwoWayBindingView/>
        </TabItem>
        <TabItem Header="Одноразовая привязка">
            <views:OneTimeBindingView/>
        </TabItem>
        <TabItem Header="Односторонние привязки">
            <views:OneWayBindingView/>
        </TabItem>
        <TabItem Header="Триггеры">
            <views:TriggersView/>
        </TabItem>
    </TabControl>
</Window>