<UserControl x:Class="DataBindingDemo.Views.OneWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBindingDemo.ViewModels">

    <UserControl.DataContext>
        <vm:OneWayBindingViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Односторонняя привязка (OneWay)" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <GroupBox Header="Описание" Margin="10" Padding="10">
                <TextBlock Text="OneWay-привязка передаёт данные только от источника к цели.&#x0a;Изменения цели НЕ влияют на источник." 
                           FontSize="13" TextWrapping="Wrap"/>
            </GroupBox>

            <GroupBox Header="Демонстрация OneWay" Margin="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Источник (редактируемый):" FontWeight="Bold" Margin="5,3"/>
                    <TextBox Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Margin="5"/>

                    <TextBlock Text="Цель (только чтение, OneWay):" FontWeight="Bold" Margin="5,10,5,3"/>
                    <TextBlock Text="{Binding SourceText, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="Purple" Margin="5,3"/>

                    <Separator Margin="0,15"/>

                    <TextBlock Text="{Binding CurrentTimeDisplay}" FontSize="14" FontWeight="Bold" Margin="5,3"/>
                    <Button Content="Обновить время" Command="{Binding UpdateTimeCommand}"
                            Background="#FF4A90D9" Foreground="White" FontSize="14" Padding="15,8" Margin="5" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>