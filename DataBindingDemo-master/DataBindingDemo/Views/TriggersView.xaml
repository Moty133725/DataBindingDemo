<UserControl x:Class="DataBindingDemo.Views.TriggersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBindingDemo.ViewModels">

    <UserControl.DataContext>
        <vm:TriggersViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Триггеры" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <GroupBox Header="Property Trigger (Триггер свойства)" Margin="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Срабатывает при изменении свойства DependencyProperty." FontSize="11" Foreground="Gray" Margin="5,0"/>
                    <CheckBox Content="Наведите курсор или отметьте флажок" IsChecked="{Binding IsChecked}" Margin="5,10"/>
                    <Border x:Name="TriggerBorder" Width="200" Height="50" Background="LightGray" CornerRadius="5" Margin="5">
                        <TextBlock Text="Property Trigger Demo" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="Bold" Margin="5,3"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Data Trigger (Триггер данных)" Margin="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Срабатывает при изменении значения привязанных данных." FontSize="11" Foreground="Gray" Margin="5,0"/>
                    <TextBlock Text="Введите число (0-100):" Margin="5,3"/>
                    <TextBox Text="{Binding NumericValue, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Margin="5"/>
                    <TextBlock x:Name="ValidatedText" Text="{Binding ValidationMessage}" FontSize="16" FontWeight="Bold" Margin="5,10"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Event Trigger (Триггер события)" Margin="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Срабатывает при возникновении события (анимации)." FontSize="11" Foreground="Gray" Margin="5,0"/>
                    <Button Content="Наведите курсор для анимации" Width="280" Height="45"
                            Background="#FF4A90D9" Foreground="White" FontSize="14" Margin="5">
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="Button.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="350" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Button.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="280" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="MultiTrigger (Мультитриггер)" Margin="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Срабатывает при выполнении нескольких условий." FontSize="11" Foreground="Gray" Margin="5,0"/>
                    <CheckBox x:Name="MultiCheck1" Content="Условие 1" Margin="5"/>
                    <CheckBox x:Name="MultiCheck2" Content="Условие 2" Margin="5"/>
                    <Border x:Name="MultiTriggerBorder" Width="250" Height="50" Background="LightGray" CornerRadius="5" Margin="5,10">
                        <TextBlock Text="Оба условия должны быть выполнены" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="5,15">
                <Button Content="Переключить состояние" Command="{Binding ToggleCheckedCommand}"
                        Background="#FF4A90D9" Foreground="White" FontSize="14" Padding="15,8" Margin="5"/>
                <Button Content="Сбросить значение" Command="{Binding ResetValueCommand}"
                        Background="#FF4A90D9" Foreground="White" FontSize="14" Padding="15,8" Margin="5"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>