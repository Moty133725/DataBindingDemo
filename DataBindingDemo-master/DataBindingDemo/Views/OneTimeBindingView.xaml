<UserControl x:Class="DataBindingDemo.Views.OneTimeBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBindingDemo.ViewModels">

    <UserControl.DataContext>
        <vm:OneTimeBindingViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Одноразовая привязка (OneTime)" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <GroupBox Header="Описание" Margin="10" Padding="10">
                <TextBlock Text="OneTime-привязка устанавливает значение один раз при инициализации.&#x0a;Изменения источника НЕ передаются в цель." 
                           FontSize="13" TextWrapping="Wrap"/>
            </GroupBox>

            <GroupBox Header="Демонстрация OneTime" Margin="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="OneTime-привязка (не обновляется):" FontWeight="Bold" Margin="5,3"/>
                    <TextBlock Text="{Binding OneTimeText, Mode=OneTime}" FontSize="14" Foreground="Green" FontWeight="Bold" Margin="5,3"/>

                    <Separator Margin="0,10"/>

                    <TextBlock Text="Измените значение в ViewModel:" FontWeight="Bold" Margin="5,3"/>
                    <TextBox Text="{Binding ChangingValue, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Margin="5"/>

                    <Separator Margin="0,10"/>

                    <TextBlock Text="{Binding OneTimeDisplay, Mode=OneTime}" FontSize="14" Foreground="Green" Margin="5,3"/>
                    <TextBlock Text="↑ Это значение НЕ изменится (OneTime)" FontSize="11" Foreground="Gray" Margin="5,0"/>

                    <TextBlock Text="{Binding CurrentValueDisplay}" FontSize="14" Foreground="Blue" Margin="5,3"/>
                    <TextBlock Text="↑ Это значение ИЗМЕНИТСЯ (OneWay)" FontSize="11" Foreground="Gray" Margin="5,0"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>