<UserControl x:Class="DataBindingDemo.Views.DefaultBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBindingDemo.ViewModels"
             xmlns:converters="clr-namespace:DataBindingDemo.Converters">

    <UserControl.DataContext>
        <vm:DefaultBindingViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <converters:BoolToStatusConverter x:Key="BoolToStatus"/>
        <converters:BoolToColorConverter x:Key="BoolToColor"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Привязка по умолчанию" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <GroupBox Header="Описание" Margin="10" Padding="10">
                <TextBlock Text="Привязка по умолчанию зависит от элемента управления.&#x0a;Для TextBox — TwoWay, для TextBlock — OneWay.&#x0a;UpdateSourceTrigger по умолчанию: LostFocus." 
                           FontSize="13" TextWrapping="Wrap"/>
            </GroupBox>

            <GroupBox Header="Прямая привязка к элементам интерфейса" Margin="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Введите текст:" Margin="5,3"/>
                    <TextBox x:Name="DirectTextBox" Text="Текст по умолчанию" FontSize="14" Margin="5"/>
                    <TextBlock Text="{Binding Text, ElementName=DirectTextBox}" 
                               FontSize="14" FontWeight="Bold" Foreground="Blue" Margin="5,3"/>
                    <TextBlock Text="↑ TextBlock.Text привязан к TextBox.Text (OneWay по умолчанию)" 
                               FontSize="11" Foreground="Gray" Margin="5,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Привязка через визуальную модель (ViewModel)" Margin="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="TextBox (TwoWay по умолчанию):" Margin="5,3"/>
                    <TextBox Text="{Binding DefaultText}" FontSize="14" Margin="5"/>

                    <TextBlock Text="{Binding DefaultText}" 
                               FontSize="14" FontWeight="Bold" Foreground="Blue" Margin="5,3"/>

                    <Separator Margin="0,10"/>

                    <CheckBox Content="Флажок (TwoWay по умолчанию)" 
                              IsChecked="{Binding CheckBoxValue}" Margin="5"/>
                    <TextBlock Text="{Binding CheckBoxStatus}" 
                               FontSize="14" Margin="5,3"
                               Foreground="{Binding CheckBoxValue, Converter={StaticResource BoolToColor}}"/>

                    <Separator Margin="0,10"/>

                    <Slider Minimum="0" Maximum="100" Value="{Binding SliderValue}" Margin="5"/>
                    <TextBlock Text="{Binding SliderDisplayText}" FontSize="14" FontWeight="Bold" Margin="5,3"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Разница подходов" Margin="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Прямая привязка (ElementName):" FontWeight="Bold" Margin="5,3"/>
                    <TextBlock Text="• Привязка к свойствам UI-элементов" FontSize="13" Margin="5,3"/>
                    <TextBlock Text="• Простая, но не масштабируемая" FontSize="13" Margin="5,3"/>

                    <TextBlock Text="Привязка через ViewModel:" FontWeight="Bold" Margin="5,10,5,3"/>
                    <TextBlock Text="• Привязка к свойствам объекта ViewModel" FontSize="13" Margin="5,3"/>
                    <TextBlock Text="• Требует реализации INotifyPropertyChanged" FontSize="13" Margin="5,3"/>
                    <TextBlock Text="• Основа паттерна MVVM" FontSize="13" Margin="5,3"/>
                </StackPanel>
            </GroupBox>

            <Button Content="Обновить статус флажка" 
                    Command="{Binding UpdateCheckBoxStatusCommand}"
                    Background="#FF4A90D9" Foreground="White"
                    FontSize="14" Padding="15,8" Margin="5"
                    HorizontalAlignment="Left"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>