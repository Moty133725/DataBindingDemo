<UserControl x:Class="DataBindingDemo.Views.TwoWayBindingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DataBindingDemo.ViewModels">

    <UserControl.DataContext>
        <vm:TwoWayBindingViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock Text="Двухсторонняя привязка (TwoWay)" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <GroupBox Header="Описание" Margin="10" Padding="10">
                <TextBlock Text="TwoWay-привязка передаёт данные в обе стороны.&#x0a;Момент обновления регулируется через UpdateSourceTrigger." 
                           FontSize="13" TextWrapping="Wrap"/>
            </GroupBox>

            <GroupBox Header="UpdateSourceTrigger = LostFocus (по умолчанию)" Margin="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Источник обновляется при потере фокуса." FontSize="11" Foreground="Gray" Margin="5,0"/>
                    <TextBox Text="{Binding LostFocusText}" FontSize="14" Margin="5"/>
                    <TextBlock Text="{Binding LostFocusText}" FontSize="14" FontWeight="Bold" Foreground="Blue" Margin="5,3"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="UpdateSourceTrigger = PropertyChanged" Margin="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Источник обновляется при каждом нажатии клавиши." FontSize="11" Foreground="Gray" Margin="5,0"/>
                    <TextBox Text="{Binding PropertyChangedText, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Margin="5"/>
                    <TextBlock Text="{Binding PropertyChangedText}" FontSize="14" FontWeight="Bold" Foreground="Blue" Margin="5,3"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="UpdateSourceTrigger = Explicit" Margin="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Источник обновляется только при явном вызове." FontSize="11" Foreground="Gray" Margin="5,0"/>
                    <TextBox x:Name="ExplicitTextBox" Text="{Binding ExplicitText, UpdateSourceTrigger=Explicit}" FontSize="14" Margin="5"/>
                    <TextBlock Text="{Binding ExplicitText}" FontSize="14" FontWeight="Bold" Foreground="Blue" Margin="5,3"/>
                    <Button Content="Явно обновить источник" Command="{Binding ExplicitUpdateCommand}"
                            Background="#FF4A90D9" Foreground="White" FontSize="14" Padding="15,8" Margin="5" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Другие элементы с TwoWay" Margin="10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Возраст:" Margin="5,3"/>
                    <Slider Minimum="0" Maximum="150" Value="{Binding Age}" Margin="5"/>
                    <TextBlock Text="{Binding Age, StringFormat='Возраст: {0} лет'}" FontSize="14" FontWeight="Bold" Margin="5,3"/>

                    <TextBlock Text="Выбор даты:" Margin="5,15,5,3"/>
                    <DatePicker SelectedDate="{Binding SelectedDate}" Margin="5"/>
                    <TextBlock Text="{Binding SelectedDate, StringFormat='Выбрана дата: {0:dd MMMM yyyy}'}" FontSize="14" Margin="5,3"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>